# 1. Берем официальный базовый мини-образ Linux с установленным Python 3.11
FROM python:3.13-slim

# 2. Устанавливаем в Linux системные пакеты (компилятор и библиотеки для работы с PostgreSQL),
#    которые необходимы, чтобы драйвер базы данных (asyncpg) смог успешно собраться.
#    В конце чистим за собой кэш apt, чтобы образ весил как можно меньше.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 3. Создаем внутри контейнера рабочую рабочую директорию /backend, где будет жить код
WORKDIR /backend

# 4. Копируем файл зависимостей с твоего компьютера внутрь контейнера
COPY requirements.txt .

# 5. Обновляем pip и устанавливаем все пакеты (FastAPI, SQLAlchemy и т.д.) без сохранения лишнего кэша
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 6. Копируем абсолютно весь остальной код из папки backend/ компьютера внутрь папки контейнера
COPY . .

# 7. Инструкция запуска: при старте контейнера выполнить команду запуска uvicorn.
#    --host 0.0.0.0 означает, что сервер будет слушать любые внешние запросы (чтобы до него достучался фронтенд)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
