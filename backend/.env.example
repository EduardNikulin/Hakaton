# Пароль и имя базы должны совпадать с docker .env (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecocity
SECRET_KEY=super_secret_key_for_jwt_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Радиус привязки и детекции (1 км)
INCIDENT_DETECTION_RADIUS_METERS=1000