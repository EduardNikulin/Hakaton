POSTGRES_DB=ecocity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Пароль и имя базы должны совпадать с docker .env (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecocity
SECRET_KEY=super_secret_key_for_jwt_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Радиус привязки и детекции (1 км)
INCIDENT_DETECTION_RADIUS_METERS=1000
# Минимум жалоб в радиусе для срабатывания детектора
INCIDENT_COMPLAINTS_THRESHOLD=3
# Окно поиска жалоб детектором (часы)
INCIDENT_DETECTION_WINDOW_HOURS=1
# Окно усреднения замеров/жалоб для ECI (часы)
ECI_WINDOW_HOURS=24
# Origin'ы фронтенда для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
